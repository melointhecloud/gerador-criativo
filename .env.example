# Banco (dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gerador
# Banco dos testes (o vitest lê esta variável do .env; default no código usa 5433).
# Se usar POSTGRES_PORT diferente, descomente e ajuste a porta.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/gerador_test

# gemini | fake (fake = sem custo, para desenvolver UI e fluxo)
PROVIDER=fake
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# Limites do provider de vídeo (confirmar no spike, ver docs/provider-spike.md)
MAX_SCENE_REFERENCES=3
SCENE_MAX_SECONDS=8

# fs (dev) | s3 (produção)
STORAGE=fs
LOCAL_STORAGE_DIR=./storage-data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Acesso do time
ACCESS_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres

WORKER_CONCURRENCY=4
